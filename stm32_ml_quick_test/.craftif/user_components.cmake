# Included verbatim in FirmGen's generated component integration. Inspect CMake's
# configured targets, not source-text regexes: paths may originate in subdirectories.
function(_fg_collect_targets directory output)
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    _fg_collect_targets("${child}" child_targets)
    list(APPEND targets ${child_targets})
  endforeach()
  set(${output} "${targets}" PARENT_SCOPE)
endfunction()

function(_fg_attach_unowned_sources firmware)
  _fg_collect_targets("${CMAKE_SOURCE_DIR}" targets)
  foreach(source IN LISTS ARGN)
    get_filename_component(candidate "${source}" REALPATH)
    set(owners "")
    foreach(owner IN LISTS targets)
      get_target_property(owner_dir ${owner} SOURCE_DIR)
      get_target_property(owner_sources ${owner} SOURCES)
      foreach(owned IN LISTS owner_sources)
        if(owned MATCHES "\\$<")
          # Conditional ownership cannot safely be transferred. A generator
          # expression mentioning this file requires explicit build integration.
          get_filename_component(candidate_name "${candidate}" NAME)
          string(FIND "${owned}" "${candidate_name}" mentions_candidate)
          if(NOT mentions_candidate EQUAL -1)
            message(FATAL_ERROR "FirmGen: conditional source ownership for ${candidate} in ${owner}: ${owned}. Keep this component in its existing target and remove its source-tree registration.")
          endif()
          continue()
        endif()
        get_filename_component(owned_path "${owned}" REALPATH BASE_DIR "${owner_dir}")
        if(WIN32)
          string(TOLOWER "${owned_path}" owned_path)
          string(TOLOWER "${candidate}" candidate)
        endif()
        if(owned_path STREQUAL candidate)
          list(APPEND owners "${owner}")
        endif()
      endforeach()
    endforeach()
    list(REMOVE_DUPLICATES owners)
    list(LENGTH owners owner_count)
    if(owner_count GREATER 1)
      message(FATAL_ERROR "FirmGen: conflicting source ownership for ${source}: ${owners}. Resolve the existing targets; FirmGen will not duplicate this implementation.")
    elseif(owner_count EQUAL 1)
      list(GET owners 0 owner)
      if(NOT owner STREQUAL firmware)
        get_target_property(owner_type ${owner} TYPE)
        if(NOT owner_type MATCHES "^(STATIC_LIBRARY|OBJECT_LIBRARY)$")
          message(FATAL_ERROR "FirmGen: ${source} belongs to ${owner} (${owner_type}); explicitly integrate that target instead of registering its sources.")
        endif()
        get_target_property(linked ${firmware} LINK_LIBRARIES)
        get_target_property(firmware_sources ${firmware} SOURCES)
        set(object_reference "$<TARGET_OBJECTS:${owner}>")
        if(NOT owner IN_LIST linked AND NOT object_reference IN_LIST firmware_sources)
          # Property form avoids mixing plain/keyword target_link_libraries calls.
          set_property(TARGET ${firmware} APPEND PROPERTY LINK_LIBRARIES "${owner}")
        endif()
        message(STATUS "FirmGen: preserving ${owner} ownership of ${source}")
      endif()
    else()
      target_sources(${firmware} PRIVATE "${source}")
    endif()
  endforeach()
endfunction()


