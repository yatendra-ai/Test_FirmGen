# Firmgen: compile firmware/ into the ST executable. Additive — do not edit ST files.cmake.
set(_FW_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../firmware")
if(NOT IS_DIRECTORY "${_FW_ROOT}")
  message(FATAL_ERROR "Firmgen: firmware root '${_FW_ROOT}' not found")
endif()
file(GLOB_RECURSE _FW_SOURCES CONFIGURE_DEPENDS "${_FW_ROOT}/*.c")
list(FILTER _FW_SOURCES EXCLUDE REGEX "/firmware/(tests|docs|scripts)/")
file(GLOB_RECURSE _FW_HEADERS CONFIGURE_DEPENDS "${_FW_ROOT}/*.h")
list(FILTER _FW_HEADERS EXCLUDE REGEX "/firmware/(tests|docs|scripts)/")
set(_FW_INCLUDE_DIRS "")
foreach(_hdr ${_FW_HEADERS})
  get_filename_component(_dir "${_hdr}" DIRECTORY)
  list(APPEND _FW_INCLUDE_DIRS "${_dir}")
endforeach()
if(_FW_INCLUDE_DIRS)
  list(REMOVE_DUPLICATES _FW_INCLUDE_DIRS)
endif()
if(_FW_SOURCES)
  target_sources(${CMAKE_PROJECT_NAME} PRIVATE ${_FW_SOURCES})
endif()
if(_FW_INCLUDE_DIRS)
  target_include_directories(${CMAKE_PROJECT_NAME} PRIVATE ${_FW_INCLUDE_DIRS})
endif()
